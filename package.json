{
  "name": "expense-calculator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage-postgresql": "^8.0.0",
    "@vercel/functions": "^3.9.8",
    "dotenv": "^18.0.0",
    "isbot": "^5.2.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "7.18.4",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "sequelize-cli": "^6.6.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
