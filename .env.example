# Copy to .env for local development. NEVER commit a real .env file.
# Every value below with an example is illustrative only — get real values
# through the WebDesk credentials-handoff channel (OQ-3), never hard-code
# them, never paste them into a commit, log line, or chat transcript.

# --- Shopify app credentials (Partner Dashboard) -----------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL the app is served from (ngrok/Cloudflare tunnel in dev, the
# real host in production). Must match the Partner Dashboard app URL.
SHOPIFY_APP_URL=https://example.trycloudflare.com
# Comma-separated access scopes. CONFIRMED at G0.5/ADR-0006: empty.
# Do not add a scope here without an RFC — see ADR-0006.
SCOPES=

# --- Database ------------------------------------------------------------
# Same Postgres instance/database is used for both the app's own Sequelize
# models AND the Shopify session store (ADR-0007) — one dependency, not two.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Same-region managed Postgres is still required (ADR-0001's reasoning
# survives the hosting-class change — see ADR-0010 point 6) — a cross-region
# DATABASE_URL is a latency bug waiting to happen, not a config detail.
#
# ADR-0010 (serverless connection strategy, REQUIRED companion to ADR-0009):
# in production this MUST be the provider's POOLED / transaction-mode
# endpoint (e.g. Neon's pooled host, Supabase's pooler port, or an
# equivalent PgBouncer-class front end) — app/db/sequelize.ts runs
# pool.max:1 on the assumption the pooler does the real multiplexing.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_calculator_dev
# ADR-0010 point 5: migrations (db/config/config.cjs, `npm run db:migrate`)
# use the DIRECT (unpooled) endpoint instead — DDL/advisory locks/the
# sequelize-cli meta table want a stable session a transaction-mode pooler
# does not guarantee. Falls back to DATABASE_URL in development only (loud
# warning, not silent) if left unset; REQUIRED in production.
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_calculator_dev

# --- Worker (ADR-0002 inbox drain / ADR-0008 sweeper) ---------------------
# NOTE (ADR-0009, G1.5-revision): the in-process interval workers these two
# variables originally configured (app/workers/bootstrap.server.ts) were
# REMOVED — this app runs on Vercel, where a setInterval loop has no
# guarantee of ever firing. Left here, still read by app/workers/sweeper.ts,
# because SWEEPER_WINDOW_DAYS / WEBHOOK_EVENT_RETENTION_DAYS are still real
# thresholds; WEBHOOK_DRAIN_INTERVAL_MS / SWEEPER_INTERVAL_MS are no longer
# read by anything and are kept only as a historical note for anyone
# grepping for them — safe to delete once nobody needs that context.
WEBHOOK_DRAIN_INTERVAL_MS=5000
SWEEPER_INTERVAL_MS=3600000
# Days after shop.uninstalled_at before the sweeper hard-deletes a shop that
# never received (or never successfully processed) shop/redact.
# Verify at build against 2026-07's documented webhook-delivery timings
# (ADR-0008 §5).
SWEEPER_WINDOW_DAYS=45
# Days processed webhook_event rows are retained before pruning
# (data-model.md §4.5). Verify at build.
WEBHOOK_EVENT_RETENTION_DAYS=30

# --- Serverless compliance mechanism (ADR-0009, G1.5-revision) -----------
# Fast tier (ADR-0009 D2) — post-response drain continuation, K=5 rows,
# invoked from every webhook route. Milliseconds; keep this small, it is a
# best-effort optimisation, not the guarantee.
FAST_TIER_DRAIN_BUDGET_MS=4000

# CRON_SECRET — REQUIRED in any real deployment. The cron route
# (/api/cron/tick, ADR-0009 D5) verifies `Authorization: Bearer
# $CRON_SECRET` in constant time and FAILS CLOSED (401 to everyone,
# including the platform) if this is unset. Getting this wrong ships a
# publicly-triggerable GDPR hard-delete endpoint. Generate a long random
# value (e.g. `openssl rand -hex 32`) via the credentials-handoff channel —
# never hard-code it, never commit a real value here.
CRON_SECRET=

# How often the cron tick is EXPECTED to run — must match vercel.json's
# cron schedule (kept as an env var specifically so the two are changed
# together deliberately, not left to drift; vercel.json's `schedule` field
# is a literal cron string and cannot read this env var itself, so this is a
# manual-but-flagged pairing, not an automatic one). Drives BOTH
# /healthz's cronStale threshold (max(2 x this, 30 min), ADR-0009 D6) and is
# the reference value an operator checks vercel.json's schedule against.
# Default assumes the safe fallback (ADR-0009 §Context: "daily is
# architecturally sufficient") — verify at build whether the actual Vercel
# plan tier permits a shorter interval (§8 item 2) and lower both together
# if so.
CRON_INTERVAL_MINUTES=1440

# Self-imposed wall-clock budget (ms) for one whole cron tick (ADR-0009 D4)
# — deliberately independent of, and well under, Vercel's actual max
# function duration per plan/compute generation (verify-at-build, §8 item
# 4). The tick returns cleanly and resumes next tick rather than depending
# on this number being generous.
CRON_TICK_BUDGET_MS=8000
# Slow-tier drain row cap per tick — this IS the guarantee, so larger than
# the fast tier's K=5, but still bounded independently of the wall-clock
# budget above.
CRON_DRAIN_MAX_ROWS=200
# Sweeper page size per tick (ADR-0009 D3) — bounds findShopsUninstalledBefore
# so a large 45-day-sweep backlog resumes across multiple ticks instead of
# one unbounded pass. The 45-day window has 30+ days of slack, so resuming
# tomorrow costs nothing in compliance terms.
CRON_SWEEP_LIMIT=50

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
